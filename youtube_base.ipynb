    "import os\n",
    "import re\n",
    "import cv2\n",
    "import requests\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from datetime import datetime, timedelta\n",
    "from googleapiclient.discovery import build\n",
    "\n",
    "# ==========================================\n",
    "# 0. 초기 설정 (API 키 입력)\n",
    "# 구글 API 키는 발급받아야함"\n,
    "# ==========================================\n",
    "API_KEY = 'YOUR API KEY'\n",
    "youtube = build('youtube', 'v3', developerKey=API_KEY)\n",
    "\n",
    "# ==========================================\n",
    "# 1. 데이터 수집 (API)\n",
    "# ==========================================\n",
    "def get_channel_data(channel_id, days=30):\n",
    "    print(f\"\\n📡 채널[{channel_id}] 최근 {days}일 영상 수집 시작...\")\n",
    "    res = youtube.channels().list(id=channel_id, part='contentDetails').execute()\n",
    "    playlist_id = res['items'][0]['contentDetails']['relatedPlaylists']['uploads']\n",
    "    cutoff_date = datetime.utcnow() - timedelta(days=days)\n",
    "    \n",
    "    videos = []\n",
    "    next_page_token = None\n",
    "    \n",
    "    while True:\n",
    "        res = youtube.playlistItems().list(playlistId=playlist_id, part='snippet', maxResults=50, pageToken=next_page_token).execute()\n",
    "        for item in res['items']:\n",
    "            video_id = item['snippet']['resourceId']['videoId']\n",
    "            title = item['snippet']['title']\n",
    "            published_at = datetime.strptime(item['snippet']['publishedAt'], \"%Y-%m-%dT%H:%M:%SZ\")\n",
    "            if published_at < cutoff_date:\n",
    "                return videos\n",
    "            videos.append({'channel_id': channel_id, 'video_id': video_id, 'title': title})\n",
    "            \n",
    "        next_page_token = res.get('nextPageToken')\n",
    "        if not next_page_token: break\n",
    "    return videos\n",
    "\n",
    "def get_video_details(video_id):\n",
    "    stats_res = youtube.videos().list(id=video_id, part='statistics').execute()\n",
    "    stats = stats_res['items'][0]['statistics']\n",
    "    \n",
    "    comments = []\n",
    "    try:\n",
    "        comment_res = youtube.commentThreads().list(videoId=video_id, part='snippet', order='relevance', maxResults=20).execute()\n",
    "        for item in comment_res['items']:\n",
    "            comments.append(item['snippet']['topLevelComment']['snippet']['textOriginal'])\n",
    "    except:\n",
    "        pass\n",
    "        \n",
    "    return {\n",
    "        'view_count': int(stats.get('viewCount', 0)),\n",
    "        'like_count': int(stats.get('likeCount', 0)),\n",
    "        'comment_count': int(stats.get('commentCount', 0)),\n",
    "        'comments': comments\n",
    "    }\n",
    "\n",
    "# ==========================================\n",
    "# 2. 텍스트 & 메타데이터 전처리\n",
    "# ==========================================\n",
    "def preprocess_metadata(df):\n",
    "    print(\"⚙️ 텍스트 및 메타데이터 피처 엔지니어링 중...\")\n",
    "    df['like_view_ratio'] = df['like_count'] / (df['view_count'] + 1)\n",
    "    df['comment_view_ratio'] = df['comment_count'] / (df['view_count'] + 1)\n",
    "    \n",
    "    df['title_punct_count'] = df['title'].apply(lambda x: len(re.findall(r'[!?~]', str(x))))\n",
    "    pattern = '|'.join(['충격', '경악', '진짜', '결국', '이럴수가', '무조건', '역대급'])\n",
    "    df['has_clickbait_word'] = df['title'].apply(lambda x: 1 if re.search(pattern, str(x)) else 0)\n",
    "    \n",
    "    pos_words, neg_words = ['ㅋㅋ', '유익', '최고', '좋아요'], ['어그로', '노잼', '실망', '낚시', '주작', '억까']\n",
    "    def get_sentiment(comments):\n",
    "        if not comments: return 0.5\n",
    "        text = \" \".join(comments)\n",
    "        pos = sum(text.count(w) for w in pos_words)\n",
    "        neg = sum(text.count(w) for w in neg_words)\n",
    "        if pos + neg == 0: return 0.5\n",
    "        return neg / (pos + neg)\n",
    "        \n",
    "    df['negative_comment_ratio'] = df['comments'].apply(get_sentiment)\n",
    "    return df.drop(columns=['comments'])\n",
    "\n",
    "# ==========================================\n",
    "# 3. 썸네일 이미지 비전(Vision) 피처 추출 (No Deep Learning)\n",
    "# ==========================================\n",
    "def process_thumbnails(df, save_dir=\"thumbnails\"):\n",
    "    print(f\"🖼️ 썸네일 비전 피처(OpenCV) 추출 중... (저장경로: {save_dir}/)\")\n",
    "    os.makedirs(save_dir, exist_ok=True)\n",
    "    \n",
    "    features = {'contrast': [], 'red_ratio': [], 'saturation': [], 'edge_density': []}\n",
    "    \n",
    "    for idx, row in df.iterrows():\n",
    "        video_id = row['video_id']\n",
    "        img_url = f\"https://img.youtube.com/vi/{video_id}/hqdefault.jpg\"\n",
    "        save_path = os.path.join(save_dir, f\"{video_id}.jpg\")\n",
    "        \n",
    "        # 이미지 다운로드\n",
    "        if not os.path.exists(save_path):\n",
    "            res = requests.get(img_url, stream=True)\n",
    "            if res.status_code == 200:\n",
    "                with open(save_path, 'wb') as f:\n",
    "                    for chunk in res.iter_content(1024): f.write(chunk)\n",
    "        \n",
    "        # OpenCV 순수 컴퓨터 비전 처리\n",
    "        img = cv2.imread(save_path)\n",
    "        if img is not None:\n",
    "            # 1. 대비 (Contrast)\n",
    "            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
    "            features['contrast'].append(gray.std())\n",
    "            \n",
    "            # 2. 빨간색 비율 (Red Pixel Ratio)\n",
    "            features['red_ratio'].append(np.sum(img[:, :, 2] > 200) / (img.shape[0] * img.shape[1]))\n",
    "            \n",
    "            # 3. 평균 채도 (Saturation - 쨍한 색감)\n",
    "            hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)\n",
    "            features['saturation'].append(hsv[:, :, 1].mean())\n",
    "            \n",
    "            # 4. 윤곽선 밀도 (Edge Density - 화면의 복잡도/텍스트 등)\n",
    "            edges = cv2.Canny(gray, 100, 200)\n",
    "            features['edge_density'].append(np.sum(edges == 255) / (img.shape[0] * img.shape[1]))\n",
    "        else:\n",
    "            for k in features: features[k].append(0)\n",
    "            \n",
    "    df['img_contrast'] = features['contrast']\n",
    "    df['img_red_ratio'] = features['red_ratio']\n",
    "    df['img_saturation'] = features['saturation']\n",
    "    df['img_edge_density'] = features['edge_density']\n",
    "    return df\n",
    "\n",
    "# ==========================================\n",
    "# 🎯 메인 실행부\n",
    "# ==========================================\n",
    "if __name__ == \"__main__\":\n",
    "    # 타겟 채널 ID 2개 입력\n",
    "    TARGET_CHANNELS = ['UCUj6rrhMTR9pipbAWBAMvUQ', 'UCl402YYy7RcH7PBI3npmGPQ'] \n",
    "    \n",
    "    all_videos = []\n",
    "    \n",
    "    for ch in TARGET_CHANNELS:\n",
    "        videos = get_channel_data(ch, days=30)\n",
    "        for v in videos:\n",
    "            details = get_video_details(v['video_id'])\n",
    "            v.update(details)\n",
    "            all_videos.append(v)\n",
    "            \n",
    "    raw_df = pd.DataFrame(all_videos)\n",
    "    \n",
    "    if not raw_df.empty:\n",
    "        meta_df = preprocess_metadata(raw_df)\n",
    "        final_df = process_thumbnails(meta_df)\n",
    "        final_df['is_aggro'] = 0 # 수동 라벨링을 위한 빈 컬럼\n",
    "        \n",
    "        print(\"\\n\" + \"=\"*50)\n",
    "        print(\"🎉 [순수 머신러닝용 베이스라인 데이터셋 구축 완료]\")\n",
    "        print(\"=\"*50)\n",
    "        \n",
    "        # 딥러닝 피처(text_count) 대신 OpenCV 피처 2개(saturation, edge_density) 추가\n",
    "        ml_features = ['like_view_ratio', 'comment_view_ratio', 'title_punct_count', \n",
    "                       'has_clickbait_word', 'negative_comment_ratio', \n",
    "                       'img_contrast', 'img_red_ratio', 'img_saturation', 'img_edge_density']\n",
    "        \n",
    "        print(\"\\n[머신러닝 입력용 추출 피처 확인]\")\n",
    "        print(final_df[ml_features].head())\n",
    "        \n",
    "        final_df.to_csv(\"youtube_aggro_pure_ml.csv\", index=False, encoding='utf-8-sig')\n",
    "        print(\"\\n💾 'youtube_aggro_pure_ml.csv' 파일로 저장 완료!\")"
   ]
  },
